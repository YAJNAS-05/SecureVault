# ---- Secrets (NEVER commit) ----
.env
*.local

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ---- Node / frontend ----
node_modules/
frontend/.vite/
npm-debug.log*

# ---- Thesis build (keep scripts + figures + .docx/.pdf; ignore temp renders) ----
docs/thesis/build/pages/

# NOTE: frontend/dist/ is intentionally COMMITTED so the Mac can serve the
# pre-built dashboard with Python only (no npm build required).

# ---- Runtime state (regenerated at run time) ----
runtime/*.db
runtime/*.db-journal
logs/*.log

# ---- Editor / harness ----
.claude/
.idea/
.vscode/

# ---- OS ----
.DS_Store
Thumbs.db
