# SQLInsight configuration -- copy to .env and fill in real values.
# The real .env is gitignored so your credentials never get pushed to GitHub.

# ---- Web server ----
HOST=127.0.0.1
PORT=5000
SQLINSIGHT_SECRET=change-me-to-a-random-string

# ---- Email alerts (Gmail SMTP) ----
# For Gmail you must use a 16-character App Password (NOT your normal password):
#   https://myaccount.google.com/apppasswords
ALERTS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_16_char_app_password
ALERT_FROM=you@gmail.com
ALERT_TO=you@gmail.com
# Minimum seconds between alert emails for the same source IP (anti-spam).
ALERT_COOLDOWN_SECONDS=60

# ---- IP geolocation (optional) ----
# Free token from https://ipinfo.io ; leave blank to use a no-token fallback.
IPINFO_TOKEN=

# ---- Log monitor (standalone, thesis-faithful tail -f mode) ----
# Path to an Apache/Nginx-style access log to watch in production.
# Defaults to the demo log written by the app itself.
ACCESS_LOG_PATH=logs/access.log
